        "routed": [],
        "conditional": [
          {
            "target": "skills/_shared/interaction-policy.md",
            "guard": "证据冲突、移交范围歧义或目标文件冲突会改变接手路径时"
          },
          {
            "target": "skills/_shared/workflow-brief.md",
            "guard": "用户或下游契约明确要求标准 `Workflow Brief` 时"
          },
          {
            "target": "skills/yan-conversation-handoff/reference.md",
            "guard": "准备生成完整文档时才读取"
          }
        ],
        "index_only": []
      }
