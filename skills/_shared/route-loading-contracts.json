{
  "schema_version": 3,
  "budgets": {
    "max_chars": {
      "public_entry": 8000,
      "mode": 12000,
      "completion": 4000,
      "reference": 9000,
      "examples": 15000,
      "template": 8000
    },
    "max_default_chars": {
      "public_entry": 12500,
      "mode": 31000
    }
  },
  "routes": [
    {
      "id": "yan-dev-doc",
      "source": "skills/yan-dev-doc/SKILL.md",
      "eval": {
        "suite": "skills/yan-dev-doc/evals.json",
        "required_tag": "route_minimal_loading"
      },
      "direct_resources": {
        "always": [],
        "routed": [],
        "conditional": [
          {
            "target": "skills/_shared/host-capabilities.md",
            "guard": "仅在工具、终端或路径行为存在宿主差异时读取"
          },
          {
            "target": "skills/_shared/interaction-policy.md",
            "guard": "仅在阻塞型未知或证据冲突需要用户裁决时读取"
          },
          {
            "target": "skills/_shared/workflow-brief.md",
            "guard": "只有真实跨 Agent、跨任务或稍后恢复时，才读取"
          },
          {
            "target": "skills/yan-dev-doc/publishing-openapi.md",
            "guard": "新增接口或请求/响应/鉴权/错误语义发生契约变化时"
          },
          {
            "target": "skills/yan-dev-doc/publishing-board.md",
            "guard": "只有用户明确要求看板、已有交付档案需要续写，或下游契约明确要求记录生命周期时"
          }
        ],
        "index_only": []
      }
    },
