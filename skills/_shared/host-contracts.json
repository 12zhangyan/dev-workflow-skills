    {"id": "handoff-inflight-parallel", "prompt_ref": "yan-conversation-handoff:16", "route": "handoff", "accepted_routes": ["handoff", "chat-output"], "write_scope": "none", "assertions": {"text": [{"pattern": "run-42", "min_matches": 1}, {"pattern": "在途|inFlight|正在|等待", "min_matches": 1}, {"pattern": "并行", "min_matches": 1}, {"pattern": "避免|不要重复", "min_matches": 1}]}},
    {"id": "dev-doc-artifacts", "prompt_ref": "yan-dev-doc:1", "route": "standard", "write_scope": "docs", "assertions": {"artifacts": [{"glob": "docs/**/*.md", "min_matches": 1}]}},
    {"id": "dev-doc-api-artifacts", "prompt_ref": "yan-dev-doc:17", "route": "standard", "write_scope": "docs", "assertions": {"artifacts": [{"glob": "docs/**/*.md", "min_matches": 1}, {"glob": "docs/apifox/**/*.openapi.yaml", "min_matches": 1}, {"glob": "docs/apifox/INDEX.md", "min_matches": 1}]}},
    {"id": "dev-doc-autonomous-plan", "prompt_ref": "yan-dev-doc:46", "route": "standard", "write_scope": "docs", "assertions": {"artifacts": [{"glob": "docs/**/*.md", "min_matches": 1}], "content": [{"glob": "docs/**/*.md", "pattern": "keyword", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "statuses", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "缺失", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "null", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "空数组", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "不按状态过滤", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "非空", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "任一状态|精确匹配", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "未知状态[\\s\\S]{0,100}(?:参数错误|错误)", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "orderNo[\\s\\S]{0,160}status|status[\\s\\S]{0,160}orderNo", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "聚焦契约测试", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "依赖|前置|通过后", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "并行", "min_matches": 1}, {"glob": "docs/**/*.md", "pattern": "验收|验证", "min_matches": 1}]}},
