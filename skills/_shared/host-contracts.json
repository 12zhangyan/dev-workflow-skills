    {
      "id": "handoff-source-boundaries",
      "prompt_ref": "yan-conversation-handoff:20",
      "route": "handoff",
      "accepted_routes": [
        "handoff",
        "chat-output",
        "chat",
        "chat-only"
      ],
      "write_scope": "none",
      "assertions": {
        "text": [
          {
            "pattern": "third-party-notes",
            "min_matches": 1
          },
          {
            "pattern": "revision B|版本 B|B.{0,30}(未验证|待验证|尚未)",
            "min_matches": 1
          },
          {
            "pattern": "授权|许可",
            "min_matches": 1
          },
          {
            "pattern": "离线测试",
            "min_matches": 1
          }
        ],
        "forbidden_text": [
          "此限制优先于此前(?:编辑|修复)授权",
          "在该限制持续有效时，只能读取",
          "(?:先解决|请求调整)当前?只读(?:限制|边界)"
